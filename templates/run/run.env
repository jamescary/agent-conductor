# run.env for run {{RUN_NAME}}: bash-sourceable KEY="value" lines, read by bin/conductor and by every agent.
# Empty value = feature off / default. Never put secret values in this file; use LANE_ENV_FILE.
# Double-quoted values expand $VARS when this file is sourced. Single-quote commands that read
# variables from LANE_ENV_FILE, e.g. GATES='test -n "$API_TOKEN" && pnpm test'.

# Run name (required). Also names the agents: <run-name>-<lane>, <run-name>-conductor.
RUN_NAME="{{RUN_NAME}}"

# Absolute path to the target repo's main checkout (required). Agents treat it as read-only.
REPO="{{REPO}}"

# Default base ref for lane and ticket branches (default origin/main).
BASE_REF="{{BASE_REF}}"

# Agent host: herdr (Herdr panes and worktree workspaces; empty = herdr) or paseo (Paseo agents
# and workspaces). Set by `conductor new --backend`; AGENT_KIND and the *_ARGS keys below follow it.
BACKEND="{{BACKEND}}"

{{IF herdr}}
# Herdr --kind for lane agents (required), e.g. claude, codex, opencode, omp, gemini (see `herdr agent start --help`).
AGENT_KIND="{{AGENT_KIND}}"

# Harness flag examples for AGENT_ARGS / CONDUCTOR_ARGS, copied from docs/harnesses.md in agent-conductor,
# which explains every flag and its trade-offs. Pick the lines for your AGENT_KIND / CONDUCTOR_KIND.
# Lanes write outside their own worktree ({{RUN}}/out, {{RUN}}/wt), so {{RUN}} is added as an extra dir.
# Don't add {{REPO}}: it is the read-only main checkout. Lanes write {{REPO}}/.git only through git commands.
# Values are word-split on spaces, so these paths must not contain spaces.
# Bypass flags (--dangerously-skip-permissions, --dangerously-bypass-approvals-and-sandbox, --yolo, yolo modes,
# --auto-approve, --auto) remove approval prompts and, in some harnesses, the sandbox: the agent can then run anything as you.
#
# claude (Claude Code). acceptEdits prompts for nearly every shell command (git, gates, conductor), so lanes stall:
#   auto (classifier check, needs a plan and model that offer it): AGENT_ARGS="--permission-mode auto --add-dir {{RUN}}"
#   bypass: AGENT_ARGS="--dangerously-skip-permissions --add-dir {{RUN}}"
#   attended: AGENT_ARGS="--permission-mode acceptEdits --add-dir {{RUN}}"
#   CONDUCTOR_ARGS="--permission-mode auto --add-dir {{RUN}}"
# codex (Codex CLI; network on for INSTALL_CMD, slot lock dir writable for the dev slot, mkdir -p it first):
#   AGENT_ARGS="--sandbox workspace-write --ask-for-approval on-request --add-dir {{RUN}} --add-dir $HOME/.local/state/agent-conductor -c sandbox_workspace_write.network_access=true"
#   bypass: AGENT_ARGS="--dangerously-bypass-approvals-and-sandbox"
#   CONDUCTOR_ARGS="--dangerously-bypass-approvals-and-sandbox"
# gemini (Gemini CLI):
#   AGENT_ARGS="--approval-mode yolo --include-directories {{RUN}}"
#   CONDUCTOR_ARGS="--approval-mode yolo --include-directories {{RUN}}"
# omp:
#   AGENT_ARGS="--approval-mode=yolo --add-dir={{RUN}}"
#   CONDUCTOR_ARGS="--approval-mode=yolo --add-dir={{RUN}}"
# opencode and other kinds: see docs/harnesses.md in agent-conductor.
#
# Extra args passed after `--` to `herdr agent start` for lane agents (permission mode, writable dirs).
AGENT_ARGS=""

# Herdr --kind for the conductor agent; empty = AGENT_KIND.
CONDUCTOR_KIND=""
{{END}}
{{IF paseo}}
# Paseo provider, or provider/model, for lane agents (required), e.g. claude, claude/opus, codex/gpt-5.4, omp.
# List them with `paseo provider ls` and `paseo provider models <provider>`.
AGENT_KIND="{{AGENT_KIND}}"

# Extra `paseo run` flags for lane agents, word-split on spaces: --mode <id>, --thinking <id>, --model <id>.
# Mode ids come from `paseo provider ls` / the provider's modes (examples from docs/paseo.md in agent-conductor).
# Lanes write outside their own worktree ({{RUN}}/out, {{RUN}}/wt, {{REPO}}/.git through git); Paseo has no
# extra-dir flag, so a sandboxed or asking mode turns those writes into permission requests (lane `blocked`).
# Bypass modes remove approval prompts: the agent can then run anything as you.
#
# claude:   AGENT_ARGS="--mode bypassPermissions"   (unattended; also: auto, acceptEdits = attended)
# codex:    AGENT_ARGS="--mode full-access"         (unattended; also: auto-review, auto = sandboxed)
# omp:      AGENT_ARGS="--mode full"                (unattended; also: write, ask)
# other providers: `paseo agent mode <agent-id> --list` on any agent of that provider.
AGENT_ARGS=""

# Paseo provider (or provider/model) for the conductor agent; empty = AGENT_KIND.
CONDUCTOR_KIND=""
{{END}}

# Extra args for the conductor agent (same format as AGENT_ARGS; the conductor writes under {{RUN}}).
CONDUCTOR_ARGS=""

# Dependency install command run in each new worktree, e.g. "pnpm install --frozen-lockfile". Empty = skip.
# Set it also when the install sets up the repo's git hooks (husky, Vite+ `"prepare": "vp config"`): their
# dispatcher is gitignored, so without an install a new worktree runs no hooks and git says nothing.
# Package in a subfolder: 'cd functions && yarn install --frozen-lockfile'.
INSTALL_CMD=""

# Command line that must exit 0 for a ticket to be done, e.g. "pnpm lint && pnpm typecheck && pnpm test".
GATES=""

# Dev server command, e.g. "pnpm dev". Empty = no browser checks and no dev slot.
DEV_CMD=""

# Port the dev server must bind, e.g. "3000". Shared by all lanes through the dev slot lock.
DEV_PORT=""

# Regex in dev server output that means ready, e.g. "localhost:3000".
DEV_READY_REGEX=""

# Space-separated repo-relative gitignored files copied from REPO into every new worktree, e.g. ".env.local".
COPY_FILES=""

# Absolute path to an env file exported into each lane's environment (test-account creds, tokens).
# It is sourced by bash with `set -a`: write KEY=value lines; any code in it runs as you.
{{IF herdr}}
# The path must not contain quotes or backslashes. Keep it outside the repo or under the
# gitignored run dir, chmod 600. Its values are never printed.
{{END}}
{{IF paseo}}
# Keep it outside the repo or under the gitignored run dir, chmod 600. Its values are never printed,
# but they reach the lane agent as `paseo run --env KEY=value`: Paseo stores them in the agent's
# record under ~/.paseo/agents/ (launchEnv) until the agent is deleted.
{{END}}
LANE_ENV_FILE=""
